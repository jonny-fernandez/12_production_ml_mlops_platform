# Project 12 local-development TEMPLATE ONLY - never insert real credentials here.
# Copy to .env only if you need local development overrides; .env must remain ignored.
APP_ENV=local
AUTH_REQUIRED=false
# For local authenticated development, set API_KEY in .env or API_KEY_FILE
# in a securely mounted local file, NOT in source or source control.
# API_KEY=<set-privately>
# API_KEY_FILE=<absolute-path-to-private-secret>
MODEL_NAME=p09-attrition-gb
MODEL_VERSION=1
MODEL_THRESHOLD=0.125
MLFLOW_TRACKING_URI=sqlite:///mlflow_tracking.db
DATABASE_URL=sqlite:///./mlops.db
MODEL_RELEASE_APPROVED=false
# MODEL_RELEASE_APPROVAL_REFERENCE=<independently-reviewed-change-id>
# MODEL_BUNDLE_DIR=<absolute-path-to-verified-local-bundle>
# No AWS credentials or secret values belong in this template.
