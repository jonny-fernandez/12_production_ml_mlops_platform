# CP9 design: only build from the separately ASSEMBLED/APPROVED image context.
# Never run docker build against Project 12 root for public cloud release.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    APP_ENV=cloud \
    AUTH_REQUIRED=true \
    MODEL_BUNDLE_DIR=/app/model
WORKDIR /app
COPY requirements-container.txt /app/requirements-container.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-container.txt \
    && python -m pip check \
    && groupadd --gid 10001 mlapp \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin mlapp
COPY --chown=10001:10001 src /app/src
COPY --chown=10001:10001 model /app/model
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
  CMD python -c "from urllib.request import urlopen; r=urlopen('http://127.0.0.1:8000/ready',timeout=8); assert r.status == 200" || exit 1
CMD ["uvicorn", "mlops_platform.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
